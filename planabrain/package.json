{
  "name": "planabrain",
  "version": "0.1.35",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "tsx src/cli/index.ts",
    "build": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\" && tsc -p tsconfig.json",
    "test": "node --import tsx --test $(find src -name '*.test.ts' | sort)",
    "start": "node dist/cli/index.js",
    "health": "node dist/health/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@google/genai": "^1.50.1",
    "dotenv": "^16.4.5",
    "express": "^5.2.1",
    "tokenx": "^1.3.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/node": "^22.10.2",
    "tsx": "^4.23.1",
    "typescript": "^5.7.2"
  },
  "overrides": {
    "uuid": "^14.0.0"
  }
}
