TELEGRAM_API_TOKEN=123456:ABC-YourRealToken

# 설정 대시보드. HEALTH_PORT(기본 8080)의 / 경로에서 열리며 0이면 끕니다
# 첫 접속 때 봇 로그의 설정 코드로 관리자 비밀번호를 정합니다
# 대시보드에서 저장한 값과 비밀번호 해시는 아래 파일 옆에 남고, 저장한 값은 재시작할 때 env보다 먼저 적용됩니다
# PLANABOT_DASHBOARD_ENABLED=1
# PLANABOT_DASHBOARD_STATE_PATH=.planabot/dashboard.json

# hiromi gallery viewer share (optional binary path)
# HIROMI_BIN=hiromi
# HIROMI_DOWNLOAD_DIR=/tmp/hiromi-downloads
# SENDVIS_HOST=https://send.vis.ee

PLANABRAIN_ENABLED=1
PLANABOT_SCHEDULES_PATH=.planabot/schedules.json
# planabrain 상주 서버. 봇이 시작할 때 planabrain을 한 번 띄워 루프백 HTTP로 호출하며, 0이면 요청마다 CLI 프로세스를 실행합니다
# PLANABOT_PLANABRAIN_SERVER=1
# PLANABRAIN_SERVER_PORT=0
# planabrain 데이터 루트. 미지정 시 planabrain 폴더의 상위(저장소 루트, 배포는 /app)이며 .planabrain/* 상대 경로는 여기 기준으로 풀립니다
# PLANABRAIN_DATA_DIR=/app

# 모델: codex gateway(Responses API)만 씁니다. PLANABRAIN_AI_PROVIDER는 비우거나 codex로 둡니다
CODEX_GATEWAY_API_KEY=
PLANABRAIN_CODEX_BASE_URL=http://192.168.0.9:8080/v1
PLANABRAIN_CODEX_MODEL=gpt-6-astra
# fast 모드: 답변 호출만 service_tier=priority로 보냅니다. Codex 사용량을 2.5배 씁니다
# PLANABRAIN_CODEX_FAST=1
# 보조 호출(검색어 재작성, 전달문 재작성, 기억 작성)에 쓸 모델. 비우면 주 모델을 씁니다
# PLANABRAIN_AUX_MODEL=gpt-5.6-sol
# 긴 추론을 기다리도록 HTTP 제한 시간을 늘립니다
PLANABRAIN_HTTP_TIMEOUT_MS=180000

# 응답 설정
PLANABRAIN_DELIVERY_MAX_OUTPUT_TOKENS=1024
PLANABRAIN_DELIVERY_REWRITE_ENABLED=1
PLANABRAIN_CHAT_THINKING_MODE=default
# PLANABRAIN_SYSTEM_PROMPT=
# PLANABRAIN_PERSONA_PROFILE=live
# PLANABRAIN_INTIMACY_ENABLED=1
# PLANABRAIN_INTIMACY_FALLBACK_MODEL=
# 연속 대화: 지난 대화를 정리된 형태로 매번 다시 보냅니다
# PLANABRAIN_CONTINUOUS_CHAT=1
# 시의성 질문의 검색어를 모델이 다시 만들게 합니다(0이면 질문 문장에서 요청 어미만 뗀 검색어 사용)
# PLANABRAIN_SEARCH_QUERY_REWRITE=1
PLANABRAIN_WEB_FETCH_ENABLED=1
PLANABRAIN_WEB_FETCH_TIMEOUT_MS=10000
PLANABRAIN_WEB_FETCH_MAX_BYTES=1000000
PLANABRAIN_WEB_FETCH_MAX_CHARS=12000
PLANABRAIN_WEB_FETCH_MAX_TOTAL_CHARS=18000

# 웹 검색: codex에는 검색 도구가 없어 Ollama 검색 결과를 답변 전에 미리 넣습니다
PLANABRAIN_OLLAMA_ENABLE_WEB_SEARCH=1
OLLAMA_API_KEY=YOUR_OLLAMA_API_KEY_HERE
# OLLAMA_API_KEYS=YOUR_OLLAMA_API_KEY_HERE,YOUR_SECOND_OLLAMA_API_KEY_HERE
# PLANABRAIN_OLLAMA_SEARCH_HOST=https://ollama.com
# PLANABRAIN_OLLAMA_WEB_SEARCH_MAX_RESULTS=5

# 판단 모델: 턴 판단(할 일/일정 경로, 최신 정보, 후속 질문, 인사, 기억 관련성)과 기억 저장 판단
# 비우면 Jev 키가 있을 때 Jev, 없으면 codex 보조 모델이 같은 형식으로 판단합니다. off는 규칙 판단만 씁니다
# OpenRouter는 이 판단 모델(Jev)에만 씁니다
# PLANABRAIN_DECISION_PROVIDER=jev|codex|off
# OPENROUTER_API_KEY=YOUR_OPENROUTER_API_KEY_HERE
# 비우면 OPENROUTER_API_KEY를 씁니다
# PLANABRAIN_DECISION_API_KEY=
# PLANABRAIN_DECISION_BASE_URL=https://openrouter.ai/api
# PLANABRAIN_DECISION_MODEL=typesafe/jev-1.13
# PLANABRAIN_DECISION_TIMEOUT_MS=2500
# PLANABRAIN_DECISION_CODEX_TIMEOUT_MS=8000

# AI 사용 허용 대상. 그룹은 ALLOWED_CHAT_IDS에 있는 채팅만 응답합니다
# 개인 채팅은 ALLOWED_USER_IDS가 비어 있으면 모두 허용하고, 값이 있으면 그 사용자만 허용합니다(개인 채팅에서 /chat_id로 확인)
PLANABRAIN_ALLOWED_CHAT_IDS=-1001234567890
PLANABRAIN_ALLOWED_USER_IDS=

# 메모리: 대화 기록과 장기 기억을 한 SQLite 파일에 저장합니다
PLANABOT_LOCAL_MEMORY_ENABLED=1
# PLANABOT_LOCAL_MEMORY_TOKEN_BUDGET=900
# PLANABRAIN_MEMORY_DB_PATH=.planabrain/memory.sqlite
# PLANABRAIN_MEMORY_MAX_TURNS=24
# PLANABRAIN_MEMORY_CONVERSATION_TTL_DAYS=14
# 사용자 한 명당 보관할 장기 기억 수
# PLANABRAIN_MEMORY_MAX_ITEMS=200
# 답변 뒤 보조 모델로 장기 기억을 정리합니다. 0이면 대화 기록만 저장합니다
# PLANABRAIN_MEMORY_WRITER_ENABLED=1

# Music card (Spotify / YouTube Music / Apple Music 링크를 표지 카드 이미지로 전송)
# PLANABOT_MUSIC_CARD_ENABLED=1
# PLANABOT_MUSIC_CARD_FONT_DIR=/usr/share/fonts
# PLANABOT_MUSIC_CARD_FONT_FAMILY=Noto Sans CJK KR
