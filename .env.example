TELEGRAM_API_TOKEN=123456:ABC-YourRealToken

# AI provider (chat): google | vertexexpress | geminimock | openrouter | ollama | cerebras
PLANABRAIN_AI_PROVIDER=google
PLANABRAIN_ENABLED=1
PLANABOT_TELEGRAM_DRAFT_ENABLED=1
PLANABOT_SCHEDULES_PATH=.planabot/schedules.json

# Shared model settings
PLANABRAIN_CHAT_MODEL=gemini-3-flash-preview
PLANABRAIN_CHAT_MAX_OUTPUT_TOKENS=2048
PLANABRAIN_DELIVERY_MAX_OUTPUT_TOKENS=1024
PLANABRAIN_DELIVERY_REWRITE_ENABLED=1
PLANABRAIN_CHAT_THINKING_MODE=default
PLANABRAIN_EMBEDDING_MODEL=gemini-embedding-001
PLANABRAIN_WEB_FETCH_ENABLED=1
PLANABRAIN_WEB_FETCH_TIMEOUT_MS=10000
PLANABRAIN_WEB_FETCH_MAX_BYTES=1000000
PLANABRAIN_WEB_FETCH_MAX_CHARS=12000

# 임베딩 provider (chat과 분리, 미지정 시 chat provider에서 파생): google | vertexexpress | ollama | openrouter
# 예) chat=cerebras + 임베딩=openrouter 구성:
# PLANABRAIN_EMBEDDING_PROVIDER=openrouter
# PLANABRAIN_OPENROUTER_EMBEDDING_MODEL=google/gemini-embedding-001

# Google provider
GOOGLE_API_KEY=YOUR_GOOGLE_API_KEY_HERE

# Vertex Express provider
# GOOGLE_VERTEX_EXPRESS_API_KEY=YOUR_VERTEX_EXPRESS_API_KEY_HERE
# PLANABRAIN_VERTEX_EXPRESS_API_VERSION=v1
# PLANABRAIN_VERTEX_EXPRESS_MODEL=gemini-2.5-flash
# PLANABRAIN_VERTEX_EXPRESS_EMBEDDING_MODEL=gemini-embedding-001
# PLANABRAIN_VERTEX_EXPRESS_THINKING_LEVEL=off

# GeminiMock provider
# PLANABRAIN_GEMINIMOCK_BASE_URL=http://127.0.0.1:43173
# GEMINI_CLI_API_HOST=127.0.0.1
# GEMINI_CLI_API_PORT=43173
# GEMINI_CLI_MODEL=gemini-2.5-pro

# OpenRouter provider
# OPENROUTER_API_KEY=YOUR_OPENROUTER_API_KEY_HERE
# PLANABRAIN_OPENROUTER_MODEL=google/gemini-3-flash-preview
# PLANABRAIN_OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# PLANABRAIN_OPENROUTER_SITE_URL=https://your-app.example.com
# PLANABRAIN_OPENROUTER_APP_NAME=planabot
# PLANABRAIN_OPENROUTER_ENABLE_WEB_SEARCH=1
# PLANABRAIN_OPENROUTER_WEB_SEARCH_MAX_RESULTS=5
# PLANABRAIN_OPENROUTER_WEB_SEARCH_MAX_TOTAL_RESULTS=15
# PLANABRAIN_OPENROUTER_WEB_SEARCH_CONTEXT_SIZE=medium

# Cerebras provider (chat)
# 웹 검색은 OLLAMA_API_KEY를 검색 백엔드로 재사용 (없으면 검색 비활성)
# 임베딩은 Cerebras 미지원 -> PLANABRAIN_EMBEDDING_PROVIDER로 별도 지정
# CEREBRAS_API_KEY=YOUR_CEREBRAS_API_KEY_HERE
# PLANABRAIN_CEREBRAS_MODEL=gemma-4-31b
# PLANABRAIN_CEREBRAS_BASE_URL=https://api.cerebras.ai/v1
# PLANABRAIN_CEREBRAS_ENABLE_WEB_SEARCH=1

# Ollama provider
# OLLAMA_API_KEY=YOUR_OLLAMA_API_KEY_HERE
# OLLAMA_API_KEYS=YOUR_OLLAMA_API_KEY_HERE,YOUR_SECOND_OLLAMA_API_KEY_HERE
# PLANABRAIN_OLLAMA_HOST=https://ollama.com
# PLANABRAIN_OLLAMA_SEARCH_HOST=https://ollama.com
# PLANABRAIN_OLLAMA_MODEL=gemma4:31b-cloud
# PLANABRAIN_OLLAMA_THINKING_MODE=off
# PLANABRAIN_OLLAMA_EMBEDDING_MODEL=embeddinggemma
# PLANABRAIN_OLLAMA_ENABLE_WEB_SEARCH=1
# PLANABRAIN_OLLAMA_ENABLE_WEB_FETCH=1
# PLANABRAIN_OLLAMA_WEB_SEARCH_MAX_RESULTS=5
# PLANABRAIN_OLLAMA_TOOL_MAX_ITERATIONS=4

# Beta AI allowlist
PLANABRAIN_ALLOWED_CHAT_IDS=-1001234567890
PLANABRAIN_ALLOWED_USER_IDS=123456789

# Local memory
PLANABOT_LOCAL_MEMORY_ENABLED=1
PLANABRAIN_LOCAL_GROUP_MEMORY_ENABLED=1
PLANABRAIN_LOCAL_MEMORY_COMPACTION_ENABLED=1
PLANABRAIN_LOCAL_MEMORY_CONVERSATION_TTL_DAYS=14
PLANABRAIN_LOCAL_MEMORY_RETRIEVAL_LOGGING_ENABLED=0
# PLANABRAIN_LOCAL_MEMORY_COMPACTION_KEEP_RECENT_TURNS=6
# PLANABRAIN_LOCAL_MEMORY_COMPACTION_MIN_SOURCE_TURNS=8
