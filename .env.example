TELEGRAM_API_TOKEN=123456:ABC-YourRealToken

# hiromi gallery viewer share (optional binary path)
# HIROMI_BIN=hiromi
# HIROMI_DOWNLOAD_DIR=/tmp/hiromi-downloads
# SENDVIS_HOST=https://send.vis.ee

# AI provider (chat): google | vertexexpress | geminimock | openrouter | ollama | cerebras | modelstudio | geminiweb | sub2api
PLANABRAIN_AI_PROVIDER=google
PLANABRAIN_ENABLED=1
PLANABOT_TELEGRAM_DRAFT_ENABLED=1
PLANABOT_SCHEDULES_PATH=.planabot/schedules.json
# planabrain 상주 서버. 봇이 시작할 때 planabrain을 한 번 띄워 루프백 HTTP로 호출하며, 0이면 요청마다 CLI 프로세스를 실행합니다
# PLANABOT_PLANABRAIN_SERVER=1
# PLANABRAIN_SERVER_PORT=0
# planabrain 데이터 루트. 미지정 시 planabrain 폴더의 상위(저장소 루트, 배포는 /app)이며 .planabrain/* 상대 경로는 여기 기준으로 풀립니다
# PLANABRAIN_DATA_DIR=/app

# Shared model settings
PLANABRAIN_CHAT_MODEL=gemini-3-flash-preview
PLANABRAIN_CHAT_MAX_OUTPUT_TOKENS=2048
PLANABRAIN_DELIVERY_MAX_OUTPUT_TOKENS=1024
PLANABRAIN_DELIVERY_REWRITE_ENABLED=1
PLANABRAIN_CHAT_THINKING_MODE=default
# PLANABRAIN_SYSTEM_PROMPT=
# PLANABRAIN_PERSONA_PROFILE=live
# PLANABRAIN_INTIMACY_ENABLED=1
# PLANABRAIN_INTIMACY_FALLBACK_PROVIDER=
# PLANABRAIN_INTIMACY_FALLBACK_MODEL=
# 연속 대화: 시스템 프롬프트를 고정하고 이전 턴 원문을 그대로 다시 보내 Gemini 웹 게이트웨이의 대화 이어가기(multi_turn)에 맞춥니다
# PLANABRAIN_CONTINUOUS_CHAT=1
# 시의성 질문의 검색어를 모델이 다시 만들게 합니다(0이면 질문 문장에서 요청 어미만 뗀 검색어 사용)
# PLANABRAIN_SEARCH_QUERY_REWRITE=1
# 보조 호출(검색어 재작성, 전달문 재작성)에 쓸 빠른 제공자와 모델. 비우면 주 제공자와 모델을 씁니다
# PLANABRAIN_AUX_PROVIDER=ollama
# PLANABRAIN_AUX_MODEL=gemma4:31b
PLANABRAIN_WEB_FETCH_ENABLED=1
PLANABRAIN_WEB_FETCH_TIMEOUT_MS=10000
PLANABRAIN_WEB_FETCH_MAX_BYTES=1000000
PLANABRAIN_WEB_FETCH_MAX_CHARS=12000
PLANABRAIN_WEB_FETCH_MAX_TOTAL_CHARS=18000


# Google provider
GOOGLE_API_KEY=YOUR_GOOGLE_API_KEY_HERE

# Vertex Express provider
# GOOGLE_VERTEX_EXPRESS_API_KEY=YOUR_VERTEX_EXPRESS_API_KEY_HERE
# PLANABRAIN_VERTEX_EXPRESS_API_VERSION=v1
# PLANABRAIN_VERTEX_EXPRESS_MODEL=gemini-2.5-flash
# PLANABRAIN_VERTEX_EXPRESS_THINKING_LEVEL=off

# GeminiMock provider
# PLANABRAIN_GEMINIMOCK_BASE_URL=http://127.0.0.1:43173
# GEMINI_CLI_API_HOST=127.0.0.1
# GEMINI_CLI_API_PORT=43173
# GEMINI_CLI_MODEL=gemini-2.5-pro

# OpenRouter provider
# OPENROUTER_API_KEY=YOUR_OPENROUTER_API_KEY_HERE
# PLANABRAIN_OPENROUTER_MODEL=google/gemini-3-flash-preview
# PLANABRAIN_OPENROUTER_IMAGE_MODEL=google/gemini-3-flash-preview
# PLANABRAIN_OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# PLANABRAIN_OPENROUTER_SITE_URL=https://your-app.example.com
# PLANABRAIN_OPENROUTER_APP_NAME=planabot
# PLANABRAIN_OPENROUTER_ENABLE_WEB_SEARCH=1
# PLANABRAIN_OPENROUTER_WEB_SEARCH_MAX_RESULTS=5
# PLANABRAIN_OPENROUTER_WEB_SEARCH_MAX_TOTAL_RESULTS=15
# PLANABRAIN_OPENROUTER_WEB_SEARCH_CONTEXT_SIZE=medium

# Cerebras provider (chat)
# 웹 검색은 OLLAMA_API_KEY를 검색 백엔드로 재사용 (없으면 검색 비활성)
# CEREBRAS_API_KEY=YOUR_CEREBRAS_API_KEY_HERE
# PLANABRAIN_CEREBRAS_MODEL=gemma-4-31b
# PLANABRAIN_CEREBRAS_BASE_URL=https://api.cerebras.ai/v1
# PLANABRAIN_CEREBRAS_ENABLE_WEB_SEARCH=1

# Alibaba Cloud Model Studio provider (chat)
# 웹 검색은 OLLAMA_API_KEY를 검색 백엔드로 재사용 (없으면 검색 비활성)
# MODEL_STUDIO_API_KEY=YOUR_MODEL_STUDIO_API_KEY_HERE
# PLANABRAIN_MODELSTUDIO_MODEL=qwen-plus
# PLANABRAIN_MODELSTUDIO_BASE_URL=https://token-plan.ap-southeast-1.maas.aliyuncs.com/compatible-mode/v1
# PLANABRAIN_MODELSTUDIO_ENABLE_WEB_SEARCH=1

# Geminiweb provider (self-hosted gemini-web2api-go)
# OpenAI Chat Completions 호환. OpenRouter 키와 URL을 쓰지 않습니다.
# 임베딩은 사용하지 않습니다. OpenRouter web search를 이 게이트웨이에 켜지 마십시오.
# 게이트웨이 multi_turn이 켜져 있으면 PLANABRAIN_CONTINUOUS_CHAT=1 로 맞춥니다.
# PLANABRAIN_AI_PROVIDER=geminiweb
# PLANABRAIN_GEMINIWEB_API_KEY=YOUR_GEMINIWEB_API_KEY_HERE
# PLANABRAIN_GEMINIWEB_BASE_URL=http://ROCKY_PRIVATE_IP:8083/v1
# PLANABRAIN_GEMINIWEB_MODEL=gemini-3.8-flash
# PLANABRAIN_HTTP_TIMEOUT_MS=180000
# PLANABRAIN_CONTINUOUS_CHAT=1
# PLANABRAIN_OPENROUTER_ENABLE_WEB_SEARCH=0

# Ollama provider
# OLLAMA_API_KEY=YOUR_OLLAMA_API_KEY_HERE
# OLLAMA_API_KEYS=YOUR_OLLAMA_API_KEY_HERE,YOUR_SECOND_OLLAMA_API_KEY_HERE
# PLANABRAIN_OLLAMA_HOST=https://ollama.com
# PLANABRAIN_OLLAMA_SEARCH_HOST=https://ollama.com
# PLANABRAIN_OLLAMA_MODEL=gemma4:31b-cloud
# PLANABRAIN_OLLAMA_THINKING_MODE=off
# PLANABRAIN_OLLAMA_ENABLE_WEB_SEARCH=1
# PLANABRAIN_OLLAMA_ENABLE_WEB_FETCH=1
# PLANABRAIN_OLLAMA_WEB_SEARCH_MAX_RESULTS=5
# PLANABRAIN_OLLAMA_TOOL_MAX_ITERATIONS=4

# Beta AI allowlist
PLANABRAIN_ALLOWED_CHAT_IDS=-1001234567890
PLANABRAIN_ALLOWED_USER_IDS=123456789

# Local memory
PLANABOT_LOCAL_MEMORY_ENABLED=1
PLANABRAIN_LOCAL_GROUP_MEMORY_ENABLED=1
PLANABRAIN_LOCAL_MEMORY_COMPACTION_ENABLED=1
PLANABRAIN_LOCAL_MEMORY_CONVERSATION_TTL_DAYS=14
PLANABRAIN_LOCAL_MEMORY_RETRIEVAL_LOGGING_ENABLED=0
# PLANABRAIN_LOCAL_MEMORY_COMPACTION_KEEP_RECENT_TURNS=6
# PLANABRAIN_LOCAL_MEMORY_COMPACTION_MIN_SOURCE_TURNS=8

# Music card (Spotify / YouTube Music / Apple Music 링크를 표지 카드 이미지로 전송)
# PLANABOT_MUSIC_CARD_ENABLED=1
# PLANABOT_MUSIC_CARD_FONT_DIR=/usr/share/fonts
# PLANABOT_MUSIC_CARD_FONT_FAMILY=Noto Sans CJK KR

PLANABRAIN_OPENROUTER_TEMPERATURE=
PLANABRAIN_OPENROUTER_TOP_P=
PLANABRAIN_OPENROUTER_PROVIDER_ORDER=

PLANABRAIN_SUB2API_API_KEY=
PLANABRAIN_SUB2API_BASE_URL=
PLANABRAIN_SUB2API_MODEL=gpt-5.6-luna
