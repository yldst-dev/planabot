# Telegram bot
TELEGRAM_API_TOKEN=

# Planabot notices
PLANABOT_NOTICE_CHAT_ID=
PLANABOT_NOTICE_URL=https://t.me/planabot_noti

# Health check (각 서비스별 별도 시크릿)
# 시크릿 생성: openssl rand -base64 32
HEALTH_SECRET_CORE=
HEALTH_SECRET_BRAIN=
HEALTH_PORT=8080
BRAIN_HEALTH_PORT=8081

# Cloudflare Tunnel (프로덕션 헬스체크 노출용)
CLOUDFLARE_TUNNEL_TOKEN=

# Planabrain (AI)
GOOGLE_API_KEY=
GEMINI_API_KEY=
PLANABRAIN_AI_PROVIDER=google
#PLANABRAIN_AI_PROVIDER=GeminiMock
PLANABRAIN_GEMINIMOCK_BASE_URL=
GEMINI_CLI_API_HOST=host.docker.internal
GEMINI_CLI_API_PORT=43173
GEMINI_CLI_MODEL=gemini-3-flash
PLANABRAIN_ENABLED=1
PLANABRAIN_ALLOWED_CHAT_IDS=
PLANABRAIN_ALLOWED_USER_IDS=
PLANABRAIN_GEMINI_MODEL=gemini-3-flash-preview
PLANABOT_LOCAL_MEMORY_ENABLED=1
PLANABOT_LOCAL_MEMORY_TOKEN_BUDGET=900
PLANABRAIN_LOCAL_MEMORY_DIR=.planabrain/local-memory
PLANABRAIN_LOCAL_MEMORY_STORE=sqlite
PLANABRAIN_LOCAL_MEMORY_SQLITE_PATH=.planabrain/local-memory/memory.sqlite
PLANABRAIN_LOCAL_GROUP_MEMORY_ENABLED=1
PLANABOT_TOKEN_MODEL=
PLANABOT_TOKEN_LIMIT=1024
PLANABOT_TOKEN_ESTIMATE_MULTIPLIER=1.0
PLANABRAIN_GEMINI_EMBEDDING_MODEL=gemini-embedding-001
PLANABRAIN_GEMINI_MAX_OUTPUT_TOKENS=1024
PLANABRAIN_GEMINI_VISION_MAX_OUTPUT_TOKENS=512
PLANABRAIN_INDEX_PATH=.planabrain/index.json
PLANABRAIN_MEMORY_ENABLED=
PLANABRAIN_MEMORY_MAX_MESSAGES=20
PLANABRAIN_MEMORY_DIR=.planabrain/memory

# Planabot state
PLANABOT_GROUPS_PATH=.planabot/groups.json
PLANABOT_PLANABRAIN_REPLIES_PATH=.planabot/planabrain_replies.json

# Webshare proxy (optional)
WEBSHARE_API_KEY=
# WEBSHARE_MODE=direct
# WEBSHARE_COUNTRY_CODES=
# WEBSHARE_PLAN_ID=
# WEBSHARE_PAGE_SIZE=25

# Songlink fallback (optional)
# SONGLINK_DIRECT_FALLBACK=false
